<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.adobe.aem.intelligence</groupId>
        <artifactId>aem-ai-content-copilot</artifactId>
        <version>1.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>aem-ai-content-copilot.all</artifactId>
    <packaging>content-package</packaging>

    <name>AEM AI Content Copilot - All</name>
    <description>Complete deployment package</description>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.jackrabbit</groupId>
                <artifactId>filevault-package-maven-plugin</artifactId>
                <version>1.3.2</version>
                <extensions>true</extensions>
                <configuration>
                    <group>com.adobe.aem.intelligence</group>
                    <name>aem-ai-content-copilot.all</name>
                    <packageType>container</packageType>
                    <embeddeds>
                        <embedded>
                            <groupId>com.adobe.aem.intelligence</groupId>
                            <artifactId>aem-ai-content-copilot.core</artifactId>
                            <target>/apps/intelligence/install</target>
                        </embedded>
                    </embeddeds>
                    <subPackages>
                        <subPackage>
                            <groupId>com.adobe.aem.intelligence</groupId>
                            <artifactId>aem-ai-content-copilot.ui.apps</artifactId>
                            <filter>true</filter>
                        </subPackage>
                    </subPackages>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <dependencies>
        <dependency>
            <groupId>com.adobe.aem.intelligence</groupId>
            <artifactId>aem-ai-content-copilot.core</artifactId>
            <version>1.0.0</version>
        </dependency>
        <dependency>
            <groupId>com.adobe.aem.intelligence</groupId>
            <artifactId>aem-ai-content-copilot.ui.apps</artifactId>
            <version>1.0.0</version>
            <type>zip</type>
        </dependency>
    </dependencies>
</project>

